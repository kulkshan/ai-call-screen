GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
# Needed only for the next step: connecting a real Twilio call.
PUBLIC_BASE_URL=https://YOUR-PUBLIC-HOST
TWILIO_AUTH_TOKEN=

# Browser calling: server-only credentials, never NEXT_PUBLIC values.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
# TwiML App Voice URL: PUBLIC_BASE_URL/twilio/browser-voice (POST)
# Local uses SQLite. Cloud Run must use Firestore, not container disk.
SESSION_STORE=sqlite
# Optional: set these only if you want the live telemetry panel to estimate Gemini cost.
# Enter your model's current USD price per one million tokens; leave blank to show “Rate not set”.
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
